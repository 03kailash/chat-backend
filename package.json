{
  "name": "hybrid-chat-backend",
  "version": "1.0.0",
  "private": true,
  "description": "1:1 chat API built with Express, strict TypeScript, PostgreSQL, and Firebase Firestore",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase-admin": "^13.4.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
