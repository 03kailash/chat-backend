PORT=3000
DATABASE_URL=postgresql://chat_user:chat_password@localhost:5432/chat_db
FIREBASE_PROJECT_ID=chat-backend-demo

# Set when testing with the local Firestore emulator (no service account needed):
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# For a real Firebase project: remove FIRESTORE_EMULATOR_HOST and set
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
