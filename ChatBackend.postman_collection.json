{
  "info": {
    "name": "Chat Backend - PostgreSQL + Firestore",
    "description": "Run requests in order. Create chat and send message automatically store chatId and messageId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create or Get Chat",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/chat/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "create"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userAId\": \"{{userAId}}\",\n  \"userBId\": \"{{userBId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Chat ID returned', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('chatId', pm.response.json().chatId);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Send Message",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/send",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "{{chatId}}",
            "message",
            "send"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"senderId\": \"{{userAId}}\",\n  \"text\": \"Hello Bob from Postman!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Message created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('messageId', pm.response.json().message.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "3. Get Messages",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/messages?limit=50",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "{{chatId}}",
            "messages?limit=50"
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Messages returned', () => pm.response.to.have.status(200));"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "4. Mark Message Read (Bob)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/message/{{messageId}}/read",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "{{chatId}}",
            "message",
            "{{messageId}}",
            "read"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Update Last Seen (Bob)",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/chat/{{chatId}}/lastseen",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chat",
            "{{chatId}}",
            "lastseen"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userBId}}\",\n  \"messageId\": \"{{messageId}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "6. List User Chats",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/user/{{userAId}}/chats",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "user",
            "{{userAId}}",
            "chats"
          ]
        },
        "header": []
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userAId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "userBId",
      "value": "22222222-2222-4222-8222-222222222222"
    },
    {
      "key": "chatId",
      "value": ""
    },
    {
      "key": "messageId",
      "value": ""
    }
  ]
}
